<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BindingConverter</RootNamespace>
    <AssemblyName>BindingConverter</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Platforms>x86;AnyCPU</Platforms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
    <DefaultItemExcludes>obj*/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
    <None Update="sample.docx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Data" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Data.Desktop" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Document.Processor" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Images" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Mvvm" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Office.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Pdf.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Printing.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.RichEdit.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.RichEdit.Export" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Office" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Reporting" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.RichEdit" Version="26.1.*-*" />
    <PackageReference Include="DevExpress.Wpf.Themes.All" Version="26.1.*-*" />
  </ItemGroup>
</Project>